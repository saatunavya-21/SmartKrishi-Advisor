# ===================================================================
# SMART KRISHI ADVISOR - APPLICATION CONFIGURATION TEMPLATE
# ===================================================================

spring.application.name=smart-krishi-advisor

# Database Configuration (MySQL 8)
# Replace with your local database host, port, database name, and credentials
spring.datasource.url=jdbc:mysql://localhost:3306/smart_krishi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=true

# Server Configuration
server.port=8080

# Administrator Credentials
# Can be configured here or passed via environment variables (ADMIN_EMAIL, ADMIN_PASSWORD)
admin.email=${ADMIN_EMAIL:admin@smartkrishi.com}
admin.password=${ADMIN_PASSWORD:Admin@123}

